# Solana RPC Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Trading Mode: paper (safe) or live (real funds)
TRADE_MODE=paper

# Token Detection Settings
DETECTION_THRESHOLD=72
MAX_POSITION_COUNT=3
MAX_BUY_PER_TRADE=25.0

# Risk Management
STOP_LOSS_PERCENT=8
TAKE_PROFIT_PERCENT=18
RISK_PER_TRADE=0.15

# Strategy
USER_BUY_STRATEGY=balanced

# Jupiter API
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Wallet Configuration (ONLY ENABLE AFTER DRY-RUN TESTING)
# WARNING: Never commit your actual private key to git!
WALLET_ADDRESS=
PRIVATE_KEY=
ENABLE_REAL_TRADING=false
